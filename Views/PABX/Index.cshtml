<table id="PABXdataTable" class="table table-bordered">
<thead>
<tr style="background-color:navy; color:white;">
<th>@Html.DisplayNameFor(model => model.Name)</th>
<th>@Html.DisplayNameFor(model => model.Designation)</th>
<th>@Html.DisplayNameFor(model => model.Department)</th>
<th>@Html.DisplayNameFor(model => model.Floor)</th>
<th>@Html.DisplayNameFor(model => model.Mobile)</th>
<th>PABX</th>
</tr>
</thead>
<tbody>
@{
List<string> floor = new List<string>();
floor = Model.OrderBy(t => t.Floor).Select(t => t.Floor).Distinct().ToList();
}

@foreach (var itemFloor in floor)
{
    List<PABX> pabxInThisFloor = Model.Where(t => t.Floor == itemFloor).OrderBy(t => t.PABX1).ToList();
    <tr>
        <td style="background-color:darkgray;" colspan="6">@itemFloor Floor</td>
    </tr>
    foreach (PABX item in pabxInThisFloor)
    {
    <tr>
        <td>@Html.DisplayFor(modelItem => item.Name)</td>
        <td>@Html.DisplayFor(modelItem => item.Designation)</td>
        <td>@Html.DisplayFor(modelItem => item.Department)</td>
        <td>@Html.DisplayFor(modelItem => item.Floor)</td>
        <td><span style="letter-spacing: 4px;">@item.Mobile</span></td>
        <td><span style="letter-spacing: 4px;">@item.PABX1</span></td>
    </tr>
    }
    }
</tbody></table>





