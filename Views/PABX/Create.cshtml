@model SEL_Web_Site.PABX

@{
    ViewBag.Title = "Create";
}



<!-- Masthead-->
<header class="masthead">
    <div class="container">
        @*<div class="masthead-subheading">Welcome To System Engineering Limited</div>*@
        <div class="masthead-heading text-uppercase">PABX</div>

    </div>
</header>




<!-- Services-->
<section class="page-section" id="services">
    <div class="container">
        <div class="text-center">
            <h2 class="section-heading text-uppercase">PABX Number</h2>

        </div>
        <div class="row text-center">







            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="form-horizontal">




                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })


                    <div class="form-group mb-3">
                        <div class="row">
                            <div class="col-md-2 control-label" style="text-align:right;">Name</div>
                            <div class="col-md-10">
                                @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <div class="row">
                            <div class="col-md-2 control-label" style="text-align:right;">Designation</div>
                            <div class="col-md-10">
                                @Html.EditorFor(model => model.Designation, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.Designation, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>


                    <div class="form-group mb-3">
                        <div class="row">
                            <div class="col-md-2 control-label" style="text-align:right;">Department</div>
                            <div class="col-md-10">
                                @Html.EditorFor(model => model.Department, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.Department, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>



                    <div class="form-group mb-3">
                        <div class="row">
                            <div class="col-md-2 control-label" style="text-align:right;">Floor</div>
                            <div class="col-md-10">
                                @Html.EditorFor(model => model.Floor, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.Floor, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>


                    <div class="form-group mb-3">
                        <div class="row">
                            <div class="col-md-2 control-label" style="text-align:right;">Mobile</div>
                            <div class="col-md-10">
                                @Html.EditorFor(model => model.Mobile, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.Mobile, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <div class="row">
                            <div class="col-md-2 control-label" style="text-align:right;">PABX</div>
                            <div class="col-md-10">
                                @Html.EditorFor(model => model.PABX1, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.PABX1, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>






                    <div class="form-group">
                        <div class="col-md-offset-2 col-md-10">
                            <input type="submit" value="Create" class="btn btn-primary" />
                        </div>
                    </div>



                </div>
            }








        </div>
    </div>
</section>





