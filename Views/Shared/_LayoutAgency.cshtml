<!-- Footer-->
<footer class="footer py-4">
<div class="container">
<div class="row align-items-center">
<div class="col-lg-4 text-lg-start">Copyright &copy; System Engineering Limited</div>
<div class="col-lg-4 my-3 my-lg-0">
<a class="btn btn-dark btn-social mx-2"  aria-label="Twitter"><i class="fab fa-twitter"></i></a>
<a class="btn btn-dark btn-social mx-2" href="https://www.facebook.com/profile.php?id=61567339603012" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
<a class="btn btn-dark btn-social mx-2"  aria-label="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
</div>
<div class="col-lg-4 text-lg-end">
<a class="link-dark text-decoration-none me-3" >Privacy Policy</a>
<a class="link-dark text-decoration-none" >Terms of Use</a>
