@section customCSS
{
    <style>
        section {
            margin: 0;
            padding: 10px;
        }


        /* INTRO */
        .intro {
            max-width: 900px;
            margin: 50px auto;
            padding: 0 20px;
        }

            .intro h2 {
                margin-bottom: 15px;
            }

        /* SOLUTIONS */
        .solutions-section {
            max-width: 1200px;
            margin: 80px auto;
            padding: 0 20px;
        }

        /* Headline */
        .section-header {
            text-align: center;
            margin-bottom: 50px;
        }

            .section-header h2 {
                font-size: 36px;
                font-weight: 800;
                color: #0f4c4c;
                margin-bottom: 10px;
            }

            .section-header p {
                font-size: 16px;
                color: #555;
            }

        /* Grid */
        .solutions-grid {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 8px;
        }

        .project-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 8px;
        }

        .project-card {
            height: 340px;
            border-radius: 18px;
            overflow: hidden;
            cursor: pointer;
        }

        .porject-card img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .porject-card.full {
            grid-column: 1 / -1;
        }

        .project-card:hover .overlay {
            transform: translateY(0);
        }

        /* Card */
        .solution-card {
            position: relative;
            height: 340px;
            width: 240px;
            border-radius: 18px;
            overflow: hidden;
            cursor: pointer;
        }

            .solution-card img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform 0.5s ease;
            }



        /* Overlay */
        .overlay {
            position: absolute;
            inset: 0;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            padding: 22px;
            background: linear-gradient( to top, rgba(0,0,0,0.75), rgba(0,0,0,0) );
            transform: translateY(35%);
            transition: transform 0.4s ease;
        }

        .solution-card:hover .overlay {
            transform: translateY(0);
        }

        .overlay h3 {
            font-size: 20px;
            font-weight: 700;
            color: #fff;
        }

        .overlay p {
            font-size: 14px;
            margin-top: 6px;
            color: rgba(255,255,255,0.9);
        }





        /* TABS */
        .tabs-container {
            max-width: 1200px;
            margin: auto;
        }

        .tab-content .grid {
            display: none;
            grid-template-columns: repeat(5, 1fr);
            gap: 20px;
            padding-top: 30px;
        }

            .tab-content .grid.active {
                display: grid;
            }

        .card {
            width: 250px;
            background: #fff;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 10px 25px rgba(0,0,0,0.08);
            transition: transform 0.3s ease;
        }

            .card:hover {
                transform: translateY(-6px);
            }

            .card img {
                width: 100%;
                height: 180px;
                object-fit: cover;
            }

            .card p {
                padding: 15px;
                font-weight: 600;
            }

        /* remove default bootstrap border */
        .nav-tabs {
            border-bottom: none;
            display: inline-flex;
            gap: 10px;
            background: #f3f3f3;
            padding: 6px;
            border-radius: 8px;
        }

            /* nav item fix */
            .nav-tabs .nav-item {
                margin-bottom: 0;
            }

            /* tab button style */
            .nav-tabs .nav-link {
                border: none;
                border-radius: 6px;
                padding: 10px 18px;
                background: #e0e0e0;
                color: #333;
                font-weight: 600;
                transition: all 0.25s ease;
            }

                /* hover */
                .nav-tabs .nav-link:hover {
                    background: #3a3a3a;
                    color: #fff;
                }

                /* active tab */
                .nav-tabs .nav-link.active {
                    background: #222;
                    color: #fff;
                }
    </style>


}




