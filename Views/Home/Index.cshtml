                    </div>
                    <div class="flip-card-back">
                        <p>
                            SEL targets industrial and infrastructure sectors by identifying client needs and delivering reliable, standards-compliant solutions.
                            We emphasize long-term relationships through customized services, responsive support, and consistent client engagement.
                        </p>
                        @*<a href="#" class="service-btn">Learn More</a>*@
                    </div>
                </div>
            </div>

        </div>
