                        <img src="~/Images/animated-icon/industrial.gif" alt="Industrial Automation">
                        <h4>Industrial Automation</h4>
                    </div>
                    <div class="flip-card-back">
                        <p>
                            We deliver advanced industrial automation solutions to optimize processes, improve efficiency, and reduce operational costs.
                            Our systems ensure seamless, reliable, and smart control for modern industries.
                        </p>
                        @*<a href="#" class="service-btn">Learn More</a>*@
                    </div>
                </div>
            </div>
            <!-- Card 3 -->
            <div class="flip-card">
                <div class="flip-card-inner">
