                        <img src="~/Images/animated-icon/SCADA.gif" alt="SCADA">
                        <h4>SCADA</h4>
                    </div>
                    <div class="flip-card-back">
                        <p>
                            SCADA is an advanced system used to monitor, control, and analyze industrial processes in real time.
                            It enables centralized supervision of equipment, improves operational efficiency,
                            enhances safety, and supports data-driven decision-making across industries
                        </p>
                        @*<a href="#" class="service-btn">Learn More</a>*@
                    </div>
                </div>
            </div>


            <!-- Card 4 -->
            <div class="flip-card">
                <div class="flip-card-inner">
                    <div class="flip-card-front">
