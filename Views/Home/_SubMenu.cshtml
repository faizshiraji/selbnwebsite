
@{
ViewBag.Title = ViewBag.MainMenuName;

List<MainMenu> menu = new List<MainMenu>();

try
{
menu = ViewBag.Menu;
}
catch (Exception ex)
{

}
}


<header class="masthead">
<div class="container">
<div class="masthead-subheading">@ViewBag.MainMenuName</div>
<div style="color:white;">Select Submenu</div>
</div>
</header>

<div style="padding:10px;">
<div class="association-card">
<ul>

@foreach (var submenu in menu.OrderBy(t=>t.Serial).ToList())
{

<li>
<a class="text-decoration-none" style="color:navy;" href="@Url.Action(submenu.Value,submenu.Controller)">
<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-right-circle-fill" viewBox="0 0 16 16">
<path d="M8 0a8 8 0 1 1 0 16A8 8 0 0 1 8 0M4.5 7.5a.5.5 0 0 0 0 1h5.793l-2.147 2.146a.5.5 0 0 0 .708.708l3-3a.5.5 0 0 0 0-.708l-3-3a.5.5 0 1 0-.708.708L10.293 7.5z" />
</svg>
@submenu.Name
</a>
</li>


}

</ul>
</div>
</div>
